{
  "expo": {
    "name": "MisBoletas",
    "slug": "MisBoletas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logomisboletas2.jpeg",
    "scheme": "misboletas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liritb.MisBoletas"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logomisboletas2.jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.liritb.MisBoletas",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "misboletas.tech",
              "pathPrefix": "/"
            },
            {
              "scheme": "misboletas",
              "host": "*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logomisboletas2.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0d6db176-5680-4e86-8a98-95f79f665e5b"
      }
    }
  }
}
