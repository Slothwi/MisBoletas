# Configuración de Entorno para MisBoletas Frontend

# Opciones: LOCAL | DEV | PROD
EXPO_PUBLIC_ENV=PROD

# URLs del Backend
# LOCAL: Backend en tu máquina (para desarrollo)
EXPO_PUBLIC_API_URL_LOCAL=http://192.168.88.3:8000/api/v1

# DEV: Backend en red local (para testing en otros dispositivos)
EXPO_PUBLIC_API_URL_DEV=http://192.168.88.3:8000/api/v1

# PROD: Backend en Render (producción)
EXPO_PUBLIC_API_URL_PROD=https://misboletas-backend.onrender.com/api/v1
